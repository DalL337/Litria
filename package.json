{
  "name": "litria",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/extract-sourcemaps.mjs",
    "preview": "vite preview",
    "check:architecture": "node scripts/architecture-guard.mjs && node scripts/app-shell-guard.mjs && node scripts/protected-zone-guard.mjs && node scripts/domain-contract-guard.mjs && node scripts/settings-key-guard.mjs && node scripts/editor-engine-guard.mjs",
    "test:domains": "node --test test/domains/*.test.mjs",
    "coverage": "c8 node --test test/domains/*.test.mjs",
    "measure:drag-latency": "node scripts/measure-drag-latency.mjs docs/plans/interaction-latency-samples.json",
    "check": "npm run check:architecture && npm run build",
    "bundle:servers": "node scripts/bundle-servers.mjs",
    "bundle:node": "node scripts/bundle-node.mjs",
    "bundle:conpty": "node scripts/bundle-conpty.mjs",
    "bundle": "node scripts/bundle-node.mjs && node scripts/bundle-servers.mjs && node scripts/bundle-conpty.mjs",
    "bundle:check": "node scripts/bundle-node.mjs --check && node scripts/bundle-servers.mjs --check && node scripts/bundle-conpty.mjs --check",
    "build:release": "npm run bundle && npm run build",
    "tauri": "tauri",
    "tauri:clean": "cd src-tauri && cargo clean"
  },
  "c8": {
    "include": [
      "src/**"
    ],
    "reporter": [
      "lcovonly",
      "json",
      "text-summary"
    ],
    "reports-dir": "coverage"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "konva": "^10.2.3",
    "lucide-react": "^0.563.0",
    "monaco-editor": "^0.52.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-konva": "^19.2.3",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@tauri-apps/cli": "^2.9.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.27",
    "c8": "^11.0.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "vite": "^7.0.4"
  }
}
