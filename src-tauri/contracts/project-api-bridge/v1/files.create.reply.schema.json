{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BridgeReply",
  "description": "A reply, as JavaScript sends it (the JSON text of the reply command's\n`reply` argument). Read strictly: unknown fields are rejected.",
  "oneOf": [
    {
      "description": "The owner's answer.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "result"
        },
        "result": {
          "$ref": "#/$defs/CreateFilesResult"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "result"
      ]
    },
    {
      "description": "The owner refused or failed. Never forwarded as text.",
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/BridgeErrorCode"
        },
        "kind": {
          "type": "string",
          "const": "error"
        },
        "message": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "code",
        "message"
      ]
    }
  ],
  "$defs": {
    "BridgeErrorCode": {
      "oneOf": [
        {
          "description": "The request's epoch is not the one the owner's state belongs to.",
          "type": "string",
          "const": "workspaceChanged"
        },
        {
          "description": "The owner does not know the operation.",
          "type": "string",
          "const": "unknownOperation"
        },
        {
          "description": "The owner could not read the request.",
          "type": "string",
          "const": "invalidRequest"
        },
        {
          "description": "Any other failure.",
          "type": "string",
          "const": "internal"
        }
      ]
    },
    "CreateFilesResult": {
      "description": "JavaScript → Rust: one entry per requested file, in request order.",
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CreatedFile"
          },
          "maxItems": 16,
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "files"
      ]
    },
    "CreatedFile": {
      "oneOf": [
        {
          "description": "Created on disk with exactly the requested text.",
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "const": "created"
            },
            "path": {
              "type": "string",
              "maxLength": 1024,
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "outcome",
            "path"
          ]
        },
        {
          "description": "Not created: something has the name. Nothing was replaced.",
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "const": "exists"
            },
            "path": {
              "type": "string",
              "maxLength": 1024,
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "outcome",
            "path"
          ]
        },
        {
          "description": "Not created, for any other reason.",
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "const": "failed"
            },
            "path": {
              "type": "string",
              "maxLength": 1024,
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "outcome",
            "path"
          ]
        }
      ]
    }
  }
}
