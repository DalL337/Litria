{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChangesApplyResult",
  "type": "object",
  "properties": {
    "changes": {
      "description": "Per change, once the plan ran: what each one did or found.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ChangeOutcome"
      }
    },
    "effects": {
      "description": "Where the changes that landed went, once any did: `buffer` (edits, in\nthe editor, unsaved), then `disk` (new files).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Effect"
      }
    },
    "planId": {
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/PlanState"
    }
  },
  "required": [
    "planId",
    "state"
  ],
  "$defs": {
    "ChangeOutcome": {
      "description": "One change of a plan that ran. A reader that meets an unfamiliar\n`outcome` must not assume anything changed.",
      "oneOf": [
        {
          "description": "Changed; the document's revision now.",
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "const": "applied"
            },
            "path": {
              "type": "string"
            },
            "revision": {
              "type": "string"
            }
          },
          "required": [
            "outcome",
            "path",
            "revision"
          ]
        },
        {
          "description": "Would have applied, but another document of the plan did not: nothing\nwas applied.",
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "const": "ready"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "outcome",
            "path"
          ]
        },
        {
          "description": "The editor holds another revision now.",
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "const": "conflict"
            },
            "path": {
              "type": "string"
            },
            "revision": {
              "type": "string"
            }
          },
          "required": [
            "outcome",
            "path",
            "revision"
          ]
        },
        {
          "description": "The edit at this index matches nowhere any more.",
          "type": "object",
          "properties": {
            "edit": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "outcome": {
              "type": "string",
              "const": "noMatch"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "outcome",
            "path",
            "edit"
          ]
        },
        {
          "description": "The edit at this index matches more than once now.",
          "type": "object",
          "properties": {
            "edit": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "outcome": {
              "type": "string",
              "const": "ambiguous"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "outcome",
            "path",
            "edit"
          ]
        },
        {
          "description": "The editor no longer holds the document.",
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "const": "notInSession"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "outcome",
            "path"
          ]
        },
        {
          "description": "The new file was created on disk; its revision as created.",
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "const": "created"
            },
            "path": {
              "type": "string"
            },
            "revision": {
              "type": "string"
            }
          },
          "required": [
            "outcome",
            "path",
            "revision"
          ]
        },
        {
          "description": "Not created: something has the new file's name now, on disk or open in\nthe editor. Nothing was replaced.",
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "const": "exists"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "outcome",
            "path"
          ]
        },
        {
          "description": "Not created: the file could not be written, or the workspace changed\nwhile creating.",
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "const": "failed"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "outcome",
            "path"
          ]
        },
        {
          "description": "Not created: the path is withheld now (it passes through a link that\nappeared since the proposal). Nothing was written.",
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "const": "denied"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "outcome",
            "path"
          ]
        }
      ]
    },
    "Effect": {
      "oneOf": [
        {
          "description": "Edits applied to the editor's copy of documents; not saved to disk.",
          "type": "string",
          "const": "buffer"
        },
        {
          "description": "New files created on disk.",
          "type": "string",
          "const": "disk"
        }
      ]
    },
    "PlanState": {
      "description": "Where a plan stands. A reader that meets an unfamiliar value must not\nassume the plan was applied.",
      "oneOf": [
        {
          "description": "Ready: `litria_changes_apply` applies it.",
          "type": "string",
          "const": "prepared"
        },
        {
          "description": "Waiting for a person to approve or reject it. Only when Litria is set\nto review agent edits itself (off by default).",
          "type": "string",
          "const": "pendingReview"
        },
        {
          "description": "Approved, and being applied now.",
          "type": "string",
          "const": "applying"
        },
        {
          "description": "Every change landed: edits in the editor (unsaved), new files on disk.",
          "type": "string",
          "const": "applied"
        },
        {
          "description": "Some changes landed and some did not; each change's outcome says which.\nNever retried: propose the rest again.",
          "type": "string",
          "const": "partial"
        },
        {
          "description": "A person rejected it. Nothing was applied.",
          "type": "string",
          "const": "rejected"
        },
        {
          "description": "Nobody answered within ten minutes. Nothing was applied.",
          "type": "string",
          "const": "expired"
        },
        {
          "description": "A document changed after the plan was prepared, so nothing was applied.\nPropose again against the current text.",
          "type": "string",
          "const": "conflict"
        },
        {
          "description": "Applying could not reach the editor. Nothing was applied.",
          "type": "string",
          "const": "failed"
        },
        {
          "description": "Applying reached the editor but its outcome is unknown (it did not\nanswer in time). Check the documents; the plan is never retried.",
          "type": "string",
          "const": "needsReview"
        },
        {
          "description": "Not a plan of this connection and workspace, or one long expired.",
          "type": "string",
          "const": "unknown"
        }
      ]
    }
  }
}
