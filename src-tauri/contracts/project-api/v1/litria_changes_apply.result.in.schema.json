{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChangesApplyResult",
  "type": "object",
  "properties": {
    "changes": {
      "description": "Per document, once applied (each new revision) or in conflict (what\neach document no longer matched).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ChangeOutcome"
      }
    },
    "effect": {
      "description": "Where an applied plan's changes went: the editor's copy, not saved.",
      "anyOf": [
        {
          "$ref": "#/$defs/Effect"
        },
        {
          "type": "null"
        }
      ]
    },
    "planId": {
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/PlanState"
    }
  },
  "required": [
    "planId",
    "state"
  ],
  "$defs": {
    "ChangeOutcome": {
      "description": "One document of a plan that was applied or found in conflict. A reader\nthat meets an unfamiliar `outcome` must not assume the document changed.",
      "oneOf": [
        {
          "description": "Changed; the document's revision now.",
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "const": "applied"
            },
            "path": {
              "type": "string"
            },
            "revision": {
              "type": "string"
            }
          },
          "required": [
            "outcome",
            "path",
            "revision"
          ]
        },
        {
          "description": "Would have applied, but another document of the plan did not: nothing\nwas applied.",
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "const": "ready"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "outcome",
            "path"
          ]
        },
        {
          "description": "The editor holds another revision now.",
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "const": "conflict"
            },
            "path": {
              "type": "string"
            },
            "revision": {
              "type": "string"
            }
          },
          "required": [
            "outcome",
            "path",
            "revision"
          ]
        },
        {
          "description": "The edit at this index matches nowhere any more.",
          "type": "object",
          "properties": {
            "edit": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "outcome": {
              "type": "string",
              "const": "noMatch"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "outcome",
            "path",
            "edit"
          ]
        },
        {
          "description": "The edit at this index matches more than once now.",
          "type": "object",
          "properties": {
            "edit": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "outcome": {
              "type": "string",
              "const": "ambiguous"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "outcome",
            "path",
            "edit"
          ]
        },
        {
          "description": "The editor no longer holds the document.",
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "const": "notInSession"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "outcome",
            "path"
          ]
        }
      ]
    },
    "Effect": {
      "oneOf": [
        {
          "description": "Applied to the editor's copy of each document; not saved to disk.",
          "type": "string",
          "const": "buffer"
        }
      ]
    },
    "PlanState": {
      "description": "Where a plan stands. A reader that meets an unfamiliar value must not\nassume the plan was applied.",
      "oneOf": [
        {
          "description": "Ready: `litria_changes_apply` applies it.",
          "type": "string",
          "const": "prepared"
        },
        {
          "description": "Waiting for a person to approve or reject it. Only when Litria is set\nto review agent edits itself (off by default).",
          "type": "string",
          "const": "pendingReview"
        },
        {
          "description": "Approved, and being applied now.",
          "type": "string",
          "const": "applying"
        },
        {
          "description": "Applied to the editor: the documents hold the changes, unsaved.",
          "type": "string",
          "const": "applied"
        },
        {
          "description": "A person rejected it. Nothing was applied.",
          "type": "string",
          "const": "rejected"
        },
        {
          "description": "Nobody answered within ten minutes. Nothing was applied.",
          "type": "string",
          "const": "expired"
        },
        {
          "description": "A document changed after the plan was prepared, so nothing was applied.\nPropose again against the current text.",
          "type": "string",
          "const": "conflict"
        },
        {
          "description": "Applying could not reach the editor. Nothing was applied.",
          "type": "string",
          "const": "failed"
        },
        {
          "description": "Applying reached the editor but its outcome is unknown (it did not\nanswer in time). Check the documents; the plan is never retried.",
          "type": "string",
          "const": "needsReview"
        },
        {
          "description": "Not a plan of this connection and workspace, or one long expired.",
          "type": "string",
          "const": "unknown"
        }
      ]
    }
  }
}
