{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProjectContext",
  "type": "object",
  "properties": {
    "languages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/LanguageCapabilities"
      }
    },
    "projectName": {
      "type": "string"
    },
    "selection": {
      "description": "Omitted from output when empty; defaults to empty on input.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/NodeRef"
      }
    },
    "workspaceEpoch": {
      "description": "Opaque workspace epoch (ADR-032). A string, never a JSON number.",
      "type": "string"
    }
  },
  "required": [
    "workspaceEpoch",
    "projectName",
    "languages"
  ],
  "$defs": {
    "LanguageCapabilities": {
      "description": "One language's capabilities, reported separately: installing a language\nserver does not imply all six.",
      "type": "object",
      "properties": {
        "diagnostics": {
          "type": "boolean"
        },
        "documentAccess": {
          "type": "boolean"
        },
        "languageId": {
          "type": "string"
        },
        "navigation": {
          "type": "boolean"
        },
        "relationshipDiscovery": {
          "type": "boolean"
        },
        "sourceTransformations": {
          "type": "boolean"
        },
        "symbols": {
          "type": "boolean"
        }
      },
      "required": [
        "languageId",
        "documentAccess",
        "diagnostics",
        "navigation",
        "symbols",
        "relationshipDiscovery",
        "sourceTransformations"
      ]
    },
    "NodeRef": {
      "type": "object",
      "properties": {
        "nodeId": {
          "description": "Opaque node identifier.",
          "type": "string"
        },
        "path": {
          "description": "Project-relative path, when the node is backed by a file.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "nodeId"
      ]
    }
  }
}
