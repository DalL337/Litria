{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FilesReadResult",
  "type": "object",
  "properties": {
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DocumentOutcome"
      }
    }
  },
  "required": [
    "documents"
  ],
  "$defs": {
    "DocumentOutcome": {
      "description": "Per-document outcome. A reader that meets an unfamiliar `kind` must treat\nit as unknown, never as one of these.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "dirty": {
              "description": "Defaulted on input (a producer may omit it); always emitted on\noutput — the field that makes this type's two directions differ.",
              "type": "boolean",
              "default": false
            },
            "documentId": {
              "description": "Opaque document identity.",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "read"
            },
            "path": {
              "type": "string"
            },
            "revision": {
              "description": "Opaque revision token.",
              "type": "string"
            },
            "source": {
              "$ref": "#/$defs/DocumentSource"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path",
            "documentId",
            "revision",
            "source",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "notFound"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "denied"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "tooLarge"
            },
            "limitBytes": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path",
            "limitBytes"
          ]
        }
      ]
    },
    "DocumentSource": {
      "type": "string",
      "enum": [
        "editor",
        "disk"
      ]
    }
  }
}
