# Normalize line endings across all platforms.
# Default: treat as text, store LF in the repo, check out LF on every OS.
* text=auto eol=lf

# Windows-only shell scripts must keep CRLF to run correctly.
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# Binary assets — never diff, never normalize.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.eot    binary
*.otf    binary
*.mp3    binary
*.mp4    binary
*.wav    binary
*.zip    binary
*.gz     binary
*.tar    binary
*.7z     binary
*.exe    binary
*.dll    binary
*.dylib  binary
*.so     binary
*.node   binary
*.db     binary
*.sqlite binary
*.sqlite3 binary
*.pdf    binary
